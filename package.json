{
  "name": "paritenu",
  "version": "1.0.1",
  "private": true,
  "description": "Pari tenu ! — paris gratuits entre amis : pronostics, cotes du groupe, classement.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "admin": "node --disable-warning=ExperimentalWarning scripts/admin.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=src src/server.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "icons": "node scripts/icons.mjs",
    "version": "node scripts/version.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "license": "MIT",
  "homepage": "https://github.com/duckplatform/PariTenu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckplatform/PariTenu.git"
  },
  "bugs": {
    "url": "https://github.com/duckplatform/PariTenu/issues"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
