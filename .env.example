# Configuration de PariTenu : copier ce fichier en « .env » (dans le dossier de l'app), puis l'adapter.
# Une variable d'environnement déjà définie (service système, hébergeur, terminal) l'emporte toujours sur ce fichier.
# Les valeurs ci-dessous sont celles par défaut : une ligne retirée garde la même valeur.
# Le nom du site, son adresse publique, ses textes, son icône et son thème se règlent dans /admin (page Configuration).

# Adresse d'écoute du serveur HTTP. Ignorées quand l'hébergeur choisit lui-même le port (Phusion Passenger).
PORT=5190
HOST=0.0.0.0

# La base SQLite : un seul fichier, créé au premier démarrage (un chemin relatif part du dossier de l'app).
# À côté se rangent l'icône téléversée (branding/), les images des sources (media/) et les sauvegardes (backups/).
# En production, mieux vaut un dossier hors du code, par exemple /var/lib/paritenu/paritenu.db.
PT_DB_PATH=data/paritenu.db

# Cookies « Secure » (envoyés seulement en HTTPS) :
#   auto   : quand la page arrive en HTTPS (directement ou par un proxy de confiance)
#   always : toujours (conseillé en production, derrière HTTPS)
#   never  : jamais (développement en HTTP sur le réseau local)
PT_COOKIE_SECURE=auto

# Proxy de confiance, pour lire l'adresse IP des visiteurs (limites contre les essais de PIN) et le protocole :
#   loopback : un proxy sur la même machine (nginx, Caddy, Apache…)
#   1, 2…    : le nombre de proxys devant l'app
#   false    : aucun (l'app reçoit les visiteurs en direct)
PT_TRUST_PROXY=loopback

# Clé personnelle et gratuite de Padel API (https://padelapi.org/register). Vide : pas de paris de padel.
PT_PADEL_TOKEN=

# Mode production (recommandé sur un serveur).
# NODE_ENV=production
